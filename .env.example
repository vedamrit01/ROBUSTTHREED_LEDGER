# SERVER ONLY. Copy this file to .env in the project root.
# Never put real credentials in a VITE_ variable or commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=robustthreed_ledger
# Set true for a remote MySQL server; certificate verification remains enabled.
DB_SSL=false
# Optional path to your provider's CA certificate; required for a private CA.
DB_SSL_CA=
# Cloud alternative: paste the provider's complete PEM CA certificate here.
# Use actual newlines inside quotes, or a single line with literal \n separators.
DB_SSL_CA_PEM=

# npm run password:set writes a scrypt hash here, never the login password.
LEDGER_PASSWORD_HASH=
# Optional cloud login: leave these blank when using password:set above.
# The Render Blueprint generates LEDGER_AUTH_SALT and prompts for LEDGER_PASSWORD.
LEDGER_PASSWORD=
LEDGER_AUTH_SALT=
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of trusted reverse proxy hops. Leave 0 for direct connections.
TRUST_PROXY_HOPS=0
